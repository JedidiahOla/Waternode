# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Server ---
DEBUG=false
PORT=5000
DATABASE_PATH=waternode.db

# --- Secrets (required when DEBUG=false) ---
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Must match the API_KEY compiled into the ESP32 firmware's config.h
API_KEY=

# Set to false to make the dashboard JSON endpoints (/api/latest, /api/history,
# /api/alerts) publicly readable with no key. Off by default.
DASHBOARD_REQUIRE_AUTH=true

# --- Twilio SMS (optional, leave blank to disable SMS, logs only) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_PHONE_NUMBER=
